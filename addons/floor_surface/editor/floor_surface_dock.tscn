[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://addons/floor_surface/editor/floor_surface_dock.gd" id="1_dock"]

[sub_resource type="ButtonGroup" id="ButtonGroup_shape"]

[sub_resource type="ButtonGroup" id="ButtonGroup_edit_mode"]

[sub_resource type="ButtonGroup" id="ButtonGroup_elevation_operation"]

[sub_resource type="ButtonGroup" id="ButtonGroup_style_operation"]

[sub_resource type="ButtonGroup" id="ButtonGroup_transition_operation"]

[node name="FloorSurfaceDock" type="ScrollContainer"]
custom_minimum_size = Vector2(280, 0)
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 2
follow_focus = true
script = ExtResource("1_dock")

[node name="Content" type="VBoxContainer" parent="."]
size_flags_horizontal = 3

[node name="Title" type="Label" parent="Content"]
tooltip_text = "Floor Surface editor. Left-drag applies Brush or Rectangle; Fill and Sample use a click. Ramp painting drags between flat high and low landings. Esc cancels the active gesture. Middle/right mouse navigates."
theme_override_font_sizes/font_size = 18
text = "Floor Surface"

[node name="TargetLabel" type="Label" parent="Content"]
unique_name_in_owner = true
text = "Target: select a FloorSurface"
clip_text = true
text_overrun_behavior = 3

[node name="OwnershipLabel" type="Label" parent="Content"]
unique_name_in_owner = true
text = "No editable FloorMap selected."
clip_text = true
text_overrun_behavior = 3

[node name="ResourceButtons" type="HFlowContainer" parent="Content"]

[node name="MakeUniqueButton" type="Button" parent="Content/ResourceButtons"]
unique_name_in_owner = true
disabled = true
text = "Use Independent Copy"
tooltip_text = "Copy the shared FloorMap into this scene so edits here cannot change another surface."

[node name="SaveButton" type="Button" parent="Content/ResourceButtons"]
tooltip_text = "Save the selected external FloorMap file. Independent scene-local maps are saved with their scene."
unique_name_in_owner = true
disabled = true
text = "Save Map"

[node name="ConformGroundedButton" type="Button" parent="Content"]
unique_name_in_owner = true
disabled = true
text = "Conform Grounded Objects"
tooltip_text = "Move scene objects with FloorSurfaceGrounding components onto this surface as one undoable action."

[node name="ValidationButtons" type="HFlowContainer" parent="Content"]

[node name="ValidateButton" type="Button" parent="Content/ValidationButtons"]
unique_name_in_owner = true
disabled = true
text = "Validate"
tooltip_text = "List floor, ramp, material, transform and grounded-object problems without changing the scene."

[node name="RepairButton" type="Button" parent="Content/ValidationButtons"]
unique_name_in_owner = true
disabled = true
text = "Repair Safe Issues"
tooltip_text = "Make invalid ramp cells flat as one undoable action; ambiguous authoring choices are never changed."

[node name="DiagnosticsLabel" type="Label" parent="Content"]
unique_name_in_owner = true
text = "Diagnostics have not been run."
clip_text = true
text_overrun_behavior = 3

[node name="Separator" type="HSeparator" parent="Content"]

[node name="EditToggle" type="CheckButton" parent="Content"]
unique_name_in_owner = true
disabled = true
text = "Enable Viewport Painting"
tooltip_text = "Left-drag applies Brush or Rectangle. Fill/Sample: click a cell. Ramp Paint: drag between flat high/low landings. Esc cancels the gesture. Middle/right mouse navigates."

[node name="GridOverlayToggle" type="CheckButton" parent="Content"]
unique_name_in_owner = true
disabled = true
text = "Show Grid / Checker Guide"
tooltip_text = "Temporary editor-only alignment guide. Turn it off to inspect the actual floor texture."

[node name="EditModeLabel" type="Label" parent="Content"]
text = "Edit"

[node name="EditModeButtons" type="HFlowContainer" parent="Content"]

[node name="FloorShapeButton" type="Button" parent="Content/EditModeButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_edit_mode")
text = "Floor Shape"

[node name="ElevationButton" type="Button" parent="Content/EditModeButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_edit_mode")
text = "Elevation"

[node name="StyleButton" type="Button" parent="Content/EditModeButtons"]
tooltip_text = "Paint or sample floor styles. Configure each FloorStyle resource in the Inspector."
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_edit_mode")
text = "Style"

[node name="TransitionButton" type="Button" parent="Content/EditModeButtons"]
tooltip_text = "Create, flatten or rotate ramps. Paint Ramp drags between flat high and low landings."
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_edit_mode")
text = "Ramp"

[node name="ShapeControls" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true

[node name="PaintModeLabel" type="Label" parent="Content/ShapeControls"]
text = "Operation"

[node name="PaintModeOption" type="OptionButton" parent="Content/ShapeControls"]
tooltip_text = "Paint floor adds tiles and expands the floor as needed. Erase removes tiles and automatically trims unused outer bounds."
unique_name_in_owner = true
disabled = true

[node name="ElevationControls" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
visible = false

[node name="ElevationReadout" type="Label" parent="Content/ElevationControls"]
unique_name_in_owner = true
text = "Elevation 0 — 0.00 m"
clip_text = true
text_overrun_behavior = 3

[node name="AbsoluteElevation" type="SpinBox" parent="Content/ElevationControls"]
tooltip_text = "Absolute elevation in profile units; the readout shows the corresponding height in metres."
unique_name_in_owner = true
min_value = -10000.0
max_value = 10000.0
step = 1.0
allow_greater = true
allow_lesser = true
suffix = " units"

[node name="ElevationOperationButtons" type="HFlowContainer" parent="Content/ElevationControls"]

[node name="SetElevationButton" type="Button" parent="Content/ElevationControls/ElevationOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Set"
tooltip_text = "Paint cells directly to the entered absolute elevation."

[node name="RaiseElevationButton" type="Button" parent="Content/ElevationControls/ElevationOperationButtons"]
tooltip_text = "Raise each painted cell by one elevation unit per gesture."
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Raise +1"

[node name="LowerElevationButton" type="Button" parent="Content/ElevationControls/ElevationOperationButtons"]
tooltip_text = "Lower each painted cell by one elevation unit per gesture."
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Lower -1"

[node name="SampleElevationButton" type="Button" parent="Content/ElevationControls/ElevationOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Sample"
tooltip_text = "Click an existing floor cell to copy its absolute elevation into the entry."

[node name="StyleControls" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
visible = false

[node name="StyleLabel" type="Label" parent="Content/StyleControls"]
text = "Surface style"

[node name="StyleOption" type="OptionButton" parent="Content/StyleControls"]
tooltip_text = "Paint chooses a palette entry. Edit that FloorStyle resource in the Inspector to set separate Top, Wall and Pit Bottom materials, floor/wall texture scales and pit depth."
unique_name_in_owner = true
disabled = true
clip_text = true
fit_to_longest_item = false

[node name="StyleOperationButtons" type="HBoxContainer" parent="Content/StyleControls"]

[node name="PaintStyleButton" type="Button" parent="Content/StyleControls/StyleOperationButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
