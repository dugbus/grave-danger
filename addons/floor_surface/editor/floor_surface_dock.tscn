[node name="SampleStyleButton" type="Button" parent="Content/StyleControls/StyleOperationButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_style_operation")
