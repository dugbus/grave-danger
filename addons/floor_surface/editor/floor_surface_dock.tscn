[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://addons/floor_surface/editor/floor_surface_dock.gd" id="1_dock"]

[sub_resource type="ButtonGroup" id="ButtonGroup_shape"]

[sub_resource type="ButtonGroup" id="ButtonGroup_edit_mode"]

[sub_resource type="ButtonGroup" id="ButtonGroup_elevation_operation"]

[sub_resource type="ButtonGroup" id="ButtonGroup_style_operation"]

[node name="FloorSurfaceDock" type="VBoxContainer"]
custom_minimum_size = Vector2(280, 0)
script = ExtResource("1_dock")

[node name="Title" type="Label" parent="."]
theme_override_font_sizes/font_size = 18
text = "Floor Surface"

[node name="TargetLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "Target: select a FloorSurface"
autowrap_mode = 2

[node name="OwnershipLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "No editable FloorMap selected."
autowrap_mode = 2

[node name="ResourceButtons" type="HFlowContainer" parent="."]

[node name="MakeUniqueButton" type="Button" parent="ResourceButtons"]
unique_name_in_owner = true
disabled = true
text = "Use Independent Copy"
tooltip_text = "Copy the shared FloorMap into this scene so edits here cannot change another surface."

[node name="SaveButton" type="Button" parent="ResourceButtons"]
unique_name_in_owner = true
disabled = true
text = "Save Map"

[node name="Separator" type="HSeparator" parent="."]

[node name="EditToggle" type="CheckButton" parent="."]
unique_name_in_owner = true
disabled = true
text = "Enable Viewport Painting"
tooltip_text = "When enabled, left-drag paints. Middle/right mouse navigation remains available."

[node name="GridOverlayToggle" type="CheckButton" parent="."]
unique_name_in_owner = true
disabled = true
text = "Show Grid / Checker Guide"
tooltip_text = "Temporary editor-only alignment guide. Turn it off to inspect the actual floor texture."

[node name="EditModeLabel" type="Label" parent="."]
text = "Edit"

[node name="EditModeButtons" type="HBoxContainer" parent="."]

[node name="FloorShapeButton" type="Button" parent="EditModeButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_edit_mode")
text = "Floor Shape"

[node name="ElevationButton" type="Button" parent="EditModeButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_edit_mode")
text = "Elevation"

[node name="StyleButton" type="Button" parent="EditModeButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_edit_mode")
text = "Style"

[node name="ShapeControls" type="VBoxContainer" parent="."]
unique_name_in_owner = true

[node name="PaintModeLabel" type="Label" parent="ShapeControls"]
text = "Operation"

[node name="PaintModeOption" type="OptionButton" parent="ShapeControls"]
unique_name_in_owner = true
disabled = true

[node name="ElevationControls" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false

[node name="ElevationReadout" type="Label" parent="ElevationControls"]
unique_name_in_owner = true
text = "Elevation 0 — 0.00 m"

[node name="AbsoluteElevation" type="SpinBox" parent="ElevationControls"]
unique_name_in_owner = true
min_value = -10000.0
max_value = 10000.0
step = 1.0
allow_greater = true
allow_lesser = true
suffix = " units"

[node name="ElevationOperationButtons" type="HFlowContainer" parent="ElevationControls"]

[node name="SetElevationButton" type="Button" parent="ElevationControls/ElevationOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Set"
tooltip_text = "Paint cells directly to the entered absolute elevation."

[node name="RaiseElevationButton" type="Button" parent="ElevationControls/ElevationOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Raise +1"

[node name="LowerElevationButton" type="Button" parent="ElevationControls/ElevationOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Lower -1"

[node name="SampleElevationButton" type="Button" parent="ElevationControls/ElevationOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_elevation_operation")
text = "Sample"
tooltip_text = "Click an existing floor cell to copy its absolute elevation into the entry."

[node name="StyleControls" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false

[node name="StyleLabel" type="Label" parent="StyleControls"]
text = "Surface style"

[node name="StyleOption" type="OptionButton" parent="StyleControls"]
unique_name_in_owner = true
disabled = true

[node name="StyleGuidance" type="Label" parent="StyleControls"]
text = "Paint chooses a palette entry. Edit that FloorStyle resource in the Inspector to change its top, edge, pit bottom, projection scale or depth."
autowrap_mode = 2

[node name="StyleOperationButtons" type="HBoxContainer" parent="StyleControls"]

[node name="PaintStyleButton" type="Button" parent="StyleControls/StyleOperationButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_style_operation")
text = "Paint Style"
tooltip_text = "Paint the selected style onto floor tiles or bounded hole cells."

[node name="SampleStyleButton" type="Button" parent="StyleControls/StyleOperationButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_style_operation")
text = "Sample"
tooltip_text = "Click a floor or bounded hole cell to copy its style into the selector."

[node name="ShapeModeLabel" type="Label" parent="."]
text = "Painting tool"

[node name="ShapeButtons" type="HBoxContainer" parent="."]

[node name="BrushButton" type="Button" parent="ShapeButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_shape")
text = "Brush"

[node name="RectangleButton" type="Button" parent="ShapeButtons"]
unique_name_in_owner = true
disabled = true
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("ButtonGroup_shape")
text = "Rectangle"

[node name="BrushSizeLabel" type="Label" parent="."]
text = "Brush size"

[node name="BrushSizeOption" type="OptionButton" parent="."]
unique_name_in_owner = true
disabled = true

[node name="HoverLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "Cell —"

[node name="Instructions" type="Label" parent="."]
text = "Left-drag: apply active tool\nRectangle: drag corner to corner\nElevation/Style Sample: click a cell\nEsc: cancel gesture\nMiddle/right mouse: navigate"
autowrap_mode = 2

[node name="StatusLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "Select a FloorSurface to begin."
autowrap_mode = 2
