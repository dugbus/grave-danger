[node name="TransitionControls" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
visible = false

[node name="TransitionOperationButtons" type="HFlowContainer" parent="Content/TransitionControls"]

[node name="PaintRampButton" type="Button" parent="Content/TransitionControls/TransitionOperationButtons"]
tooltip_text = "Drag between a flat high landing and a flat low landing. Tiles between them become one continuous ramp; a longer drag makes the same rise gentler. Esc cancels the drag."
unique_name_in_owner = true
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_transition_operation")
text = "Paint Ramp"

[node name="EraseRampButton" type="Button" parent="Content/TransitionControls/TransitionOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_transition_operation")
text = "Make Flat"
tooltip_text = "Remove the ramp transition while preserving this cell's current elevation."

[node name="RotateRampButton" type="Button" parent="Content/TransitionControls/TransitionOperationButtons"]
unique_name_in_owner = true
toggle_mode = true
button_group = SubResource("ButtonGroup_transition_operation")
text = "Rotate 90°"
tooltip_text = "Correct an existing ramp by rotating its low edge clockwise."

[node name="ShapeModeLabel" type="Label" parent="Content"]
unique_name_in_owner = true
text = "Painting tool"

[node name="ShapeButtons" type="HBoxContainer" parent="Content"]
